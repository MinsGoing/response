%%%
% Define the new environment
\newenvironment{commentresponse}[3]
{ \refstepcounter{reviewcomment@counter}
  \noindent\begin{tabular}{|p{\linewidth}|}
  \hline
  #1 \\ % Comment section
  \hline 
  #2\\
  \hline
  #3
}
{
  \\ \hline
  \end{tabular}\\[2em]
}


\newenvironment{commentdisadvantage}[3]
{ \refstepcounter{reviewdisadvantage@counter}
  \noindent\begin{tabular}{|p{\linewidth}|}
  \hline
  #1 \\ % Comment section
  \hline 
  #2\\
  \hline
  #3
}
{
  \\ \hline
  \end{tabular}\\[2em]
}



\newenvironment{revcomment}[1][{}]{%
    \textbf{\color{red}Comment \arabic{reviewer@counter}-\arabic{reviewcomment@counter}:}\par #1
}{\vspace{1em}}

\newenvironment{discomment}[1][{}]{%
    \textbf{\color{red}Disadvantage \arabic{reviewer@counter}-\arabic{reviewdisadvantage@counter}:} #1
}{\vspace{1em}}

\newenvironment{response}[1][{}]{%
    \textbf{\color{blue}Response:}\par #1
}{\vspace{1em}}

\newenvironment{changes}[1][{}]{%
    \textbf{\color{blue}Changes:}\par #1
}{\vspace{1em}}


\newenvironment{generalcomment}{%
	\begin{tcolorbox}[adjusted title={Summary Comment}, fonttitle={\bfseries}, enhanced jigsaw, colbacktitle={colorcommentframe},arc=0pt,boxrule=0em,opacityframe=0,colback={colorcommentbg}]
}{\end{tcolorbox}}


\newenvironment{revmeta}[1][{Thank you for the comment.}]{%
	\textbf{Response:} \color{lightblue}#1\par
}{\vspace{1em}}
