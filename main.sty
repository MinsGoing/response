% main.sty
\ProvidesPackage{main}[2025/10/10 v1.0 Comment and Response Environment]
\RequirePackage[breakable,skins]{tcolorbox}
\RequirePackage{amsmath}
\RequirePackage{xcolor}
%%% Counters
\newcounter{reviewer@counter}
\setcounter{reviewer@counter}{0}
\newcounter{reviewcomment@counter}[reviewer@counter]
\setcounter{reviewcomment@counter}{0}
% counter for disadvantages, reset with reviewer
\newcounter{reviewdisadvantage@counter}[reviewer@counter]
\setcounter{reviewdisadvantage@counter}{0}


